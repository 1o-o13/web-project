{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(python main.py*)",
            "command": "start http://127.0.0.1:8000",
            "shell": "powershell",
            "async": true,
            "statusMessage": "Opening browser..."
          }
        ]
      }
    ]
  }
}
